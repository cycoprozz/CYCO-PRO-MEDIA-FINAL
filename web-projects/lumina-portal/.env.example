# Authentication
JWT_SECRET=your-super-secret-jwt-key-min-32-characters
FAUNA_SECRET=your-fauna-db-secret

# Email (Resend, SendGrid, or SMTP)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=your-resend-api-key

# Image CDN (Cloudinary) – optional for Wow mode uploads
CLOUDINARY_CLOUD_NAME=your-cloud
CLOUDINARY_API_KEY=your-key
CLOUDINARY_API_SECRET=your-secret

# Wow mode overlay images (optional; URLs to PNG overlays)
# WOW_OVERLAY_BILLBOARD=https://...
# WOW_OVERLAY_MAGAZINE=https://...
# WOW_OVERLAY_GALLERY=https://...
# WOW_OVERLAY_PENTHOUSE=https://...

# Site URL (for magic links and share URLs)
URL=https://your-site.netlify.app
NODE_ENV=production
